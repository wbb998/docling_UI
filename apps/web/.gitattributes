# 文本规范（text=auto eol=crlf）- Windows 中文环境友好
* text=auto eol=crlf

# 源代码文件
*.js text eol=crlf
*.jsx text eol=crlf
*.ts text eol=crlf
*.tsx text eol=crlf
*.json text eol=crlf
*.css text eol=crlf
*.scss text eol=crlf
*.html text eol=crlf
*.md text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf

# 配置文件
*.config.js text eol=crlf
*.config.ts text eol=crlf
package.json text eol=crlf
tsconfig.json text eol=crlf
.editorconfig text eol=crlf
.gitignore text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary